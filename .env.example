# Public frontend configuration. NEVER put secrets here — every VITE_* value
# ships to the browser. Placeholders only; the app works with all of them empty.

# Hyperliquid public API base (default: https://api.hyperliquid.xyz).
VITE_HL_API_BASE=

# GitHub Pages base path, e.g. /hyperliquid-smc-stocks/ for
# https://<user>.github.io/hyperliquid-smc-stocks/ . Leave empty for local dev.
VITE_BASE_PATH=

# --- Optional Supabase persistence (Phase 7; app works locally without it) ---
# Frontend may use ONLY the publishable key (RLS enforced). NEVER put the
# service-role / sb_secret_* key in this file or any VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-side ONLY (GitHub Actions secrets / host env; never VITE_*) ---
# TELEGRAM_BOT_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=
